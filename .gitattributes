# Normalize text files in the repository and keep line endings predictable
# across Windows, macOS, and Linux.
* text=auto

# Repository-authored text uses LF in Git and in working trees.
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.py text eol=lf
*.tex text eol=lf
*.bib text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows command scripts conventionally use CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Common project binaries must never be line-ending normalized.
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
